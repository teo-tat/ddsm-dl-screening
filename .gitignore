# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environments
.ddsm-env/
.torch-env/

# System and archives
.DS_Store
*.zip

# The dataset. Only the download instructions are kept.
data/*
!data/README.md

# Generated outputs. outputs/ itself is not ignored: the small evidence a reported
# number rests on (histories, manifests, result JSONs, prediction tables) is kept,
# and only bulk and per-run scratch are ignored.

# Bulk: weights, caches, stores and probability maps.
outputs/_cuda/
outputs/weights/
outputs/cam/
outputs/localiser_tensors*/
outputs/*_store_*/
outputs/**/*.npy
outputs/**/*.npz
outputs/**/*.h5
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.keras

# Per-epoch logs, console captures and launcher scratch.
*.log
outputs/results/**/*_training.csv
outputs/logs/**/*_training.csv
outputs/results/**/*.stdout
outputs/logs/**/*.stdout
outputs/logs/launch_*/
outputs/logs/land_*/
outputs/logs/_launched/
outputs/logs/cascade_*/
outputs/logs/combined_gate_*/
outputs/logs/overnight*/
outputs/logs/weights_equiv_*/
outputs/logs/marginal_curve_*/
outputs/logs/rehearsal_*/
outputs/logs/**/events.out.tfevents.*

# The single test pass keeps its own record: the run log and the model list.
!outputs/logs/test_pass_real_*.log
!outputs/logs/test_pass_test_*.stdout
!outputs/logs/.pass_tags.txt

# The validation run of the test-pass script writes here. Its comparison and
# analysis JSONs are kept; the rest is regenerated.
outputs/results/validation/*
!outputs/results/validation/comparison_*.json
!outputs/results/validation/analysis_*.json

# Written by the integrity and dry-run tools: machine state, not results.
outputs/results_manifest.json
outputs/results_manifest.csv
outputs/results/ledger_hashes.json
outputs/results/weights_roundtrip/
outputs/results/weights_roundtrip_*/
outputs/results/*_dryrun.*
outputs/results/*_dryrun_*
refs/promoted_pointer.dryrun.json

# Written by notebook 02 when its FORCE switches rebuild the cached geometry tables.
outputs/_scratch/
